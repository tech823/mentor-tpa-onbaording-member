# ============================================================
# Mentor Onboarding API — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

NODE_ENV=development
PORT=4000

# --- Database (Neon serverless Postgres) ---
# Get this from your Neon dashboard -> Connection Details -> "Pooled connection".
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Auth ---
# Generate strong random secrets: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie settings
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- CORS (comma-separated allowed origins for the web/mobile clients) ---
CORS_ORIGINS=http://localhost:5173

# --- File storage ---
# MVP uses local disk. STORAGE_DRIVER=local | s3 (s3 to be wired later).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Max upload size in bytes (default 10MB)
MAX_UPLOAD_BYTES=10485760

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Mentor Onboarding <onboarding@example.com>"
ADMIN_NOTIFY_EMAIL=

# --- Public onboarding ---
PUBLIC_APP_URL=http://localhost:5173

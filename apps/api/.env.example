# ============================================================
# Mentor Onboarding API — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

NODE_ENV=development
PORT=4000

# --- Database (Neon serverless Postgres) ---
# Get this from your Neon dashboard -> Connection Details -> "Pooled connection".
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Auth ---
# Generate strong random secrets: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# The session has no time-based expiry; it ends only on logout. No TTL to set.
# Cookie settings
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- CORS (comma-separated allowed origins for the web/mobile clients) ---
CORS_ORIGINS=http://localhost:5173

# --- File storage ---
# STORAGE_DRIVER=local | s3 . Use "s3" in production so uploads never fill the
# app server's disk (works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Max upload size in bytes (default 10MB)
MAX_UPLOAD_BYTES=10485760

# --- S3-compatible object storage (only needed when STORAGE_DRIVER=s3) ---
S3_BUCKET=
S3_REGION=auto
# Cloudflare R2 example: https://<account_id>.r2.cloudflarestorage.com  (leave blank for AWS)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for R2 / MinIO / most non-AWS providers, false for AWS S3
S3_FORCE_PATH_STYLE=true

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Mentor Onboarding <onboarding@example.com>"
ADMIN_NOTIFY_EMAIL=

# --- Public onboarding ---
PUBLIC_APP_URL=http://localhost:5173
